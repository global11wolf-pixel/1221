function Library:CreateWindow(config)
    config = config or {}
    local windowName = config.Name or "Fluent UI"
    
    -- Update watermark with auto-detected executor
    local watermarkText = menu.hud.watermark.TextLabel
    watermarkText.Text = windowName .. " | " .. (config.Version or "v1.0") .. " | Exec: " .. (config.Executor or EXECUTOR_NAME)
    
    local Window = {
        Tabs = {},
        CurrentTab = nil,
        Config = {}
    }
    
    function Window:CreateTab(config)
        -- Support both old and new syntax
        local tabName, tabType, iconId
        
        if type(config) == "string" then
            -- Old syntax: CreateTab("Name", "type", "iconId")
            tabName = config
            tabType = arguments and arguments[1] or "visuals"
            iconId = arguments and arguments[2]
        else
            -- New syntax: CreateTab({Name = "...", Type = "...", Icon = "..."})
            config = config or {}
            tabName = config.Name
            tabType = config.Type or "visuals"
            iconId = config.Icon
        end
        
        -- Default tab names and icons
        local defaults = {
            visuals = {name = "visuals", icon = "91157903643590"},
            misc = {name = "misc", icon = "101005170699126"},
            settings = {name = "settings", icon = "105258813960131"},
            aim = {name = "aimbot", icon = "103785967336737"}
        }
        
        -- Use provided name or default
        tabName = tabName or (defaults[tabType] and defaults[tabType].name) or tabType
        iconId = iconId or (defaults[tabType] and defaults[tabType].icon)
        
        -- Update tab button icon and name
        if tabButtons[tabType] then
            local tabButton = tabButtons[tabType]
            local nameLabel = tabButton.name_tab_tex
            
            -- Update tab name
            if nameLabel and tabName then
                nameLabel.Text = tabName
            end
            
            -- Update icon if provided
            if iconId then
                local iconButton = nameLabel.ImageButton or nameLabel.icon_tab
                if iconButton then
                    iconButton.Image = "rbxassetid://" .. tostring(iconId)
                end
            end
        end
        
        -- Reset positions for new tab
        elementYPositions = {left = 0.08, middle = 0.08, right = 0.08}
        
        -- Initialize tab content storage
        if not tabContents[tabType] then
            tabContents[tabType] = {
                Name = tabName,
                left = {},
                middle = {},
                right = {}
            }
        else
            -- Update name if tab already exists
            tabContents[tabType].Name = tabName
        end
        
        local Tab = {
            Name = tabName,
            Type = tabType,
            Elements = {},
            LeftColumn = leftScroll,
            MiddleColumn = middleScroll,
            RightColumn = rightScroll
        }
        
        table.insert(self.Tabs, Tab)
        
        function Tab:AddToggle(config)
            config = config or {}
            config.Name = config.Name or "Toggle"
            config.Column = config.Column or "left"
            
