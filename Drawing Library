-- Notification System
local notificationQueue = {}
local notificationCount = 0

function Library:CreateNotification(text, duration)
    duration = duration or 3
    
    local notification = Notification1:Clone()
    notification.Name = "Notification" .. notificationCount
    notification.Parent = NotifiList
    notification.Visible = true
    
    local notifiText = notification:FindFirstChild("NotifiText")
    if notifiText then
        notifiText.Text = text
    end
    
    -- Start position (off screen right)
    notification.Position = UDim2.new(1.2, 0, 0, notificationCount * 30)
    
    -- Slide in animation
    local slideIn = TweenService:Create(
        notification,
        TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(0, 0, 0, notificationCount * 30)}
    )
    
    slideIn:Play()
    
    notificationCount = notificationCount + 1
    table.insert(notificationQueue, notification)
    
    -- Auto remove after duration
    task.delay(duration, function()
        -- Slide out animation
        local slideOut = TweenService:Create(
            notification,
            TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            {Position = UDim2.new(1.2, 0, 0, notificationCount * 30)}
        )
        
        slideOut:Play()
        slideOut.Completed:Connect(function()
            notification:Destroy()
            
            -- Remove from queue
            for i, notif in ipairs(notificationQueue) do
                if notif == notification then
                    table.remove(notificationQueue, i)
                    break
                end
            end
            
            -- Reposition remaining notifications
            for i, notif in ipairs(notificationQueue) do
                TweenService:Create(
                    notif,
                    TweenInfo.new(0.3),
                    {Position = UDim2.new(0, 0, 0, (i - 1) * 30)}
                ):Play()
            end
            
            notificationCount = math.max(0, notificationCount - 1)
        end)
    end)
end

-- HotKey System
local hotkeys = {}
local hotkeyCount = 0

function Library:CreateHotKey(name, key, callback)
    local hotkey = {
        name = name,
        key = key,
        callback = callback,
        enabled = false
    }
    
    table.insert(hotkeys, hotkey)
    
    -- Create UI element
    local hotkeyFrame = HotKey1:Clone()
    hotkeyFrame.Name = "HotKey" .. hotkeyCount
    hotkeyFrame.Parent = MainFrame
    hotkeyFrame.Position = UDim2.new(0, 0, 0.21 + (hotkeyCount * 0.22), 0)
    hotkeyFrame.Visible = true
    
    local functionName = hotkeyFrame:FindFirstChild("FunctionName")
    if functionName then
        functionName.Text = name
    end
    
    local keyLabel = hotkeyFrame:FindFirstChild("Key")
    if keyLabel then
        keyLabel.Text = key
    end
    
    hotkeyCount = hotkeyCount + 1
    
    -- Adjust MainFrame height
    MainFrame.Size = UDim2.new(0, 200, 0, 100 + (hotkeyCount * 22))
    
    return {
        SetKey = function(newKey)
            hotkey.key = newKey
            if keyLabel then
                keyLabel.Text = newKey
            end
        end,
        Remove = function()
            hotkeyFrame:Destroy()
            for i, hk in ipairs(hotkeys) do
                if hk == hotkey then
                    table.remove(hotkeys, i)
                    break
                end
            end
        end
    }
end

-- Listen for hotkey presses
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = input.KeyCode.Name
        
        for _, hotkey in ipairs(hotkeys) do
            if hotkey.key == keyName and hotkey.callback then
                hotkey.enabled = not hotkey.enabled
                hotkey.callback(hotkey.enabled)
                
                -- Show notification
                Library:CreateNotification(hotkey.name .. " " .. (hotkey.enabled and "Enabled" or "Disabled"), 2)
            end
        end
    end
end)

