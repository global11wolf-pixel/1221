            table.insert(self.Elements, toggle)
            table.insert(tabContents[self.Type][config.Column], toggle)
            
            -- Hide if not current tab
            if currentTab ~= self.Type then
                toggle.Frame.Visible = false
            end
            
            return toggle
        end
        
