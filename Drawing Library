-- Tab switching function
local function SwitchTab(tabName)
    if not tabContents[tabName] then
        return
    end
    
    currentTab = tabName
    
    -- Update button colors
    for name, button in pairs(tabButtons) do
        if name == tabName then
            button.BackgroundColor3 = Color3.fromRGB(85, 85, 83)
        else
            button.BackgroundColor3 = Color3.fromRGB(65, 65, 63)
        end
    end
    
    -- Hide all tab contents
    for tab, content in pairs(tabContents) do
        for column, elements in pairs(content) do
            for _, element in pairs(elements) do
                if element.Frame then
                    element.Frame.Visible = false
                end
            end
        end
    end
    
    -- Show current tab content
    if tabContents[tabName] then
        for column, elements in pairs(tabContents[tabName]) do
            for _, element in pairs(elements) do
                if element.Frame then
                    element.Frame.Visible = true
                end
            end
        end
    end
    
    -- Update tab names
    local tabInfo = tabContents[tabName]
    if tabInfo and tabInfo.Name then
        contentFrames.left["the name of the mini tab"]["Text_the name of the mini tab"].Text = tabInfo.Name
        contentFrames.middle["the name of the mini tab"]["Text_the name of the mini tab"].Text = tabInfo.Name
        contentFrames.right["the name of the mini tab"]["Text_the name of the mini tab"].Text = tabInfo.Name
    end
end

