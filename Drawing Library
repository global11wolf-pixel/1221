            if currentTab ~= self.Type then
                colorpicker.Frame.Visible = false
            end
            
            return colorpicker
        end
        
        function Tab:AddBind(config)
            config = config or {}
            local bindName = config.Name or "Keybind"
            local default = config.Default or Enum.KeyCode.B
            local callback = config.Callback or function() end
            local showInHotkeys = config.ShowInHotkeys ~= false
            
            local Bind = {
                Value = default,
                Name = bindName,
                Active = false
            }
            
            if showInHotkeys then
                table.insert(activeHotkeys, {
                    Name = bindName,
                    Key = tostring(default)
                })
                UpdateHotkeysDisplay()
            end
            
            function Bind:SetValue(keycode)
                self.Value = keycode
                
                if showInHotkeys then
                    for i, hk in ipairs(activeHotkeys) do
                        if hk.Name == bindName then
                            hk.Key = tostring(keycode)
                            UpdateHotkeysDisplay()
                            break
                        end
                    end
                end
            end
            
            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not gameProcessed and input.KeyCode == self.Value then
                    self.Active = true
                    callback(true)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.KeyCode == self.Value then
                    self.Active = false
                    callback(false)
                end
            end)
            
            table.insert(self.Elements, Bind)
            return Bind
        end
        
        function Tab:AddInput(config)
            config = config or {}
            local inputName = config.Name or "Input"
            local default = config.Default or ""
            local callback = config.Callback or function() end
            
            local Input = {
                Value = default,
                Name = inputName
            }
            
            function Input:SetValue(value)
                self.Value = value
                callback(value)
            end
            
            table.insert(self.Elements, Input)
            return Input
        end
        
        return Tab
    end
    
    function Window:Notify(config)
        config = config or {}
        local content = config.Content or "No content"
        local duration = config.Duration or 3
        
        -- Update notification text
        local notif = main_gui.Parent["Notification System"].NotifiList.Notification1
        notif.NotifiText.Text = content
        notif.Visible = true
        
        -- Animate notification
        Tween(notif, {Position = UDim2.new(-0.0014721680199727416, 0, 0.7, 0)}, 0.3)
        
        task.wait(duration)
        
        Tween(notif, {Position = UDim2.new(-0.0014721680199727416, 0, 0.95, 0)}, 0.3)
        task.wait(0.3)
        notif.Visible = false
    end
    
    function Window:Toggle()
        main_gui.Visible = not main_gui.Visible
    end
    
    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    function Window:SaveConfig(fileName)
        fileName = fileName or "config"
        -- Config saving logic here
        writefile(fileName .. ".json", game:GetService("HttpService"):JSONEncode(self.Config))
    end
    
    function Window:LoadConfig(fileName)
        fileName = fileName or "config"
        -- Config loading logic here
        if isfile(fileName .. ".json") then
            self.Config = game:GetService("HttpService"):JSONDecode(readfile(fileName .. ".json"))
        end
    end
    
    return Window
end

