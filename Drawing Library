    toggleButton.Position = UDim2.new(0.65, 0, 0.2, 0)
    toggleButton.BackgroundColor3 = Colors.Background
    toggleButton.Parent = toggleZone
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = toggleButton
    
    local stroke = Instance.new("UIStroke")
    stroke.Parent = toggleButton
    
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 11, 0, 11)
    indicator.Position = UDim2.new(0.05, 0, 0.13, 0)
    indicator.BackgroundColor3 = default and Colors.Active or Color3.fromRGB(100, 100, 100)
    indicator.Parent = toggleButton
    
    local indicatorCorner = Instance.new("UICorner")
    indicatorCorner.CornerRadius = UDim.new(1, 0)
    indicatorCorner.Parent = indicator
    
    local state = default
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = toggleButton
    
    button.MouseButton1Click:Connect(function()
        state = not state
        
        local targetPos = state and UDim2.new(0.65, 0, 0.13, 0) or UDim2.new(0.05, 0, 0.13, 0)
        local targetColor = state and Colors.Active or Color3.fromRGB(100, 100, 100)
        
        TweenService:Create(indicator, TweenInfo.new(0.2), {Position = targetPos, BackgroundColor3 = targetColor}):Play()
        
        if callback then
            callback(state)
        end
    end)
    
    return {
        SetValue = function(value)
            state = value
            indicator.Position = state and UDim2.new(0.65, 0, 0.13, 0) or UDim2.new(0.05, 0, 0.13, 0)
            indicator.BackgroundColor3 = state and Colors.Active or Color3.fromRGB(100, 100, 100)
        end
    }
end

-- Slider
function Library:CreateSlider(tab, column, name, min, max, default, callback)
    local tabContent = tabContents[tab]
    if not tabContent then return end
    
    local parent = tabContent[column]
    if not parent then return end
    
    local sliderZone = Instance.new("Frame")
    sliderZone.Name = "SliderZone"
    sliderZone.Size = UDim2.new(1, -10, 0, 35)
    sliderZone.BackgroundTransparency = 1
    sliderZone.Parent = parent
    
    local sliderName = Instance.new("TextLabel")
    sliderName.Name = "SliderName"
    sliderName.Size = UDim2.new(0, 80, 0, 15)
    sliderName.Position = UDim2.new(0, 0, 0, 0)
    sliderName.BackgroundTransparency = 1
    sliderName.Text = name
    sliderName.TextColor3 = Colors.Text
    sliderName.TextSize = 12
    sliderName.Font = Enum.Font.SourceSansBold
    sliderName.TextXAlignment = Enum.TextXAlignment.Left
    sliderName.Parent = sliderZone
    
    local sliderLine = Instance.new("Frame")
    sliderLine.Name = "SliderLine"
    sliderLine.Size = UDim2.new(0.6, 0, 0, 4)
    sliderLine.Position = UDim2.new(0, 0, 0, 20)
    sliderLine.BackgroundColor3 = Colors.Background
    sliderLine.Parent = sliderZone
    
    local lineCorner = Instance.new("UICorner")
    lineCorner.Parent = sliderLine
    
    local lineStroke = Instance.new("UIStroke")
    lineStroke.Parent = sliderLine
    
    local sliderHandle = Instance.new("Frame")
    sliderHandle.Size = UDim2.new(0, 10, 0, 10)
    sliderHandle.Position = UDim2.new(0.5, 0, -0.75, 0)
    sliderHandle.BackgroundColor3 = Colors.Active
    sliderHandle.Parent = sliderLine
    
    local handleCorner = Instance.new("UICorner")
    handleCorner.CornerRadius = UDim.new(1, 0)
    handleCorner.Parent = sliderHandle
    
    local sliderValue = Instance.new("Frame")
    sliderValue.Name = "SliderValue"
    sliderValue.Size = UDim2.new(0, 35, 0, 15)
    sliderValue.Position = UDim2.new(0.75, 0, 0, 0)
    sliderValue.BackgroundColor3 = Colors.Background
    sliderValue.Parent = sliderZone
    
    local valueStroke = Instance.new("UIStroke")
    valueStroke.Parent = sliderValue
    
    local valueText = Instance.new("TextLabel")
    valueText.Size = UDim2.new(1, 0, 1, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = tostring(default)
    valueText.TextColor3 = Colors.Text
    valueText.TextSize = 10
    valueText.Font = Enum.Font.SourceSans
    valueText.Parent = sliderValue
    
    local value = default
    local dragging = false
    
    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - sliderLine.AbsolutePosition.X) / sliderLine.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * pos)
        
        sliderHandle.Position = UDim2.new(pos, 0, -0.75, 0)
        valueText.Text = tostring(value)
        
        if callback then
            callback(value)
        end
    end
    
    sliderLine.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    
    sliderLine.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    return {
        SetValue = function(newValue)
            value = math.clamp(newValue, min, max)
            local pos = (value - min) / (max - min)
            if sliderHandle then
                sliderHandle.Position = UDim2.new(pos, 0, -0.75, 0)
            end
            if valueText then
                valueText.Text = tostring(value)
            end
        end
    }
end

