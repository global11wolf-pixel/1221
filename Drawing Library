    aim = {left = the_left_tab, middle = the_middle_tab, right = the_right_tab},
    visuals = {left = nil, middle = nil, right = nil},
    misc = {left = nil, middle = nil, right = nil},
    settings = {left = nil, middle = nil, right = nil}
}

-- Create content frames for other tabs
for tabName, content in pairs(tabContents) do
    if tabName ~= "aim" then
        -- Left
        content.left = the_left_tab:Clone()
        content.left.Parent = Frame
        content.left.Visible = false
        
        -- Middle
        content.middle = the_middle_tab:Clone()
        content.middle.Parent = Frame
        content.middle.Visible = false
        
        -- Right
        content.right = the_right_tab:Clone()
        content.right.Parent = Frame
        content.right.Visible = false
    end
    
    -- Add UIListLayout to all columns for automatic positioning
    for _, columnName in ipairs({"left", "middle", "right"}) do
        local column = content[columnName]
        if column then
            -- Remove old template elements
            for _, child in ipairs(column:GetChildren()) do
                if child.Name == "button folder" or child:IsA("Folder") then
                    child:Destroy()
                end
            end
            
            -- Add UIListLayout for automatic vertical stacking
            local listLayout = Instance.new("UIListLayout")
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Padding = UDim.new(0, 5)
            listLayout.FillDirection = Enum.FillDirection.Vertical
            listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            listLayout.Parent = column
        end
    end
end

-- Tab switching
local function switchTab(tabName)
    for name, content in pairs(tabContents) do
        local isActive = (name == tabName)
        
        -- Show/hide content
        if content.left then content.left.Visible = isActive end
        if content.middle then content.middle.Visible = isActive end
        if content.right then content.right.Visible = isActive end
        
        -- Update tab button colors
        local tabButton = Name_tab:FindFirstChild("tab_" .. name)
        if tabButton then
            tabButton.BackgroundColor3 = isActive and Colors.Active or Colors.Inactive
            local nameLabel = tabButton:FindFirstChild("name_tab_tex")
            if nameLabel then
                nameLabel.BackgroundColor3 = isActive and Colors.Active or Color3.fromRGB(45, 45, 44)
            end
        end
    end
end

-- Connect tab buttons
for tabName, _ in pairs(tabContents) do
    local tabButton = Name_tab:FindFirstChild("tab_" .. tabName)
    if tabButton then
        local nameLabel = tabButton:FindFirstChild("name_tab_tex")
        if nameLabel then
            local imageButton = nameLabel:FindFirstChild("ImageButton") or nameLabel:FindFirstChild("icon_tab")
            if imageButton then
                imageButton.MouseButton1Click:Connect(function()
                    switchTab(tabName)
                end)
            end
        end
    end
end

