-- Library API
function Library:CreateWindow(config)
    config = config or {}
    
    -- Update watermark (try multiple methods)
    local success, err = pcall(function()
        local watermarkFrame = ScreenGui.menu.hud.watermark
        
        -- Try TextLabel first (old version)
        local watermarkText = watermarkFrame:FindFirstChild("TextLabel")
        
        -- If not found, try TextLabel_2 (new version)
        if not watermarkText then
            watermarkText = watermarkFrame:FindFirstChild("TextLabel_2")
        end
        
        -- If still not found, try any TextLabel
        if not watermarkText then
            watermarkText = watermarkFrame:FindFirstChildOfClass("TextLabel")
        end
        
        if watermarkText then
            -- Use custom watermark text if provided, otherwise build from config
            if config.WatermarkText then
                watermarkText.Text = config.WatermarkText
            else
                local windowName = config.Name or "Fluent UI"
                local version = config.Version or "v1.0"
                local executor = config.Executor or EXECUTOR_NAME
                watermarkText.Text = windowName .. " | " .. version .. " | Exec: " .. executor
            end
            print("[Library] Watermark updated successfully to:", watermarkText.Text)
        else
            warn("[Library] TextLabel not found in watermark")
        end
    end)
    
    if not success then
        warn("[Library] Failed to update watermark:", err)
    end
    
    print("[Library] Window created:", windowName)
    print("[Library] Executor:", executorName)
    
    local Window = {
        Tabs = {},
        Config = {}
    }
    
    function Window:CreateTab(config)
        print("[Library] CreateTab called")
        local Tab = {
            Name = config.Name or "Tab",
            Type = config.Type or "visuals"
        }
        
        table.insert(self.Tabs, Tab)
        return Tab
    end
    
    function Window:Notify(config)
        config = config or {}
        local content = config.Content or "No content"
        print("[Library] Notify:", content)
    end
    
    function Window:Toggle()
        main_gui.Visible = not main_gui.Visible
    end
    
    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    return Window
end

