local SUPPORTED_EXECUTORS = {
    'Wave',
    'Swift',
    'Velocity',
    'Potassium',
    'Seliware',
    'Volcano',
    'Volt'
}

-- Auto-detect executor
local function GetExecutor()
    local executor = "Unknown"
    
    if identifyexecutor then
        executor = identifyexecutor()
    elseif WAVE_LOADED then
        executor = "Wave"
    elseif SWIFT_LOADED then
        executor = "Swift"
    elseif VELOCITY_LOADED then
        executor = "Velocity"
    elseif POTASSIUM_LOADED then
        executor = "Potassium"
    elseif SELIWARE_LOADED then
        executor = "Seliware"
    elseif VOLCANO_LOADED then
        executor = "Volcano"
    elseif VOLT_LOADED then
        executor = "Volt"
    end
    
    return executor
end

local EXECUTOR_NAME = GetExecutor()

-- Check if executor is supported
local function IsExecutorSupported()
    for _, supported in ipairs(SUPPORTED_EXECUTORS) do
        if EXECUTOR_NAME == supported then
            return true
        end
    end
    return false
end

if not IsExecutorSupported() then
    Player:Kick(`[Library] Unsupported Executor: {EXECUTOR_NAME}\n\nSupported: Wave, Swift, Velocity, Potassium, Seliware, Volcano, Volt`)
    return
end

